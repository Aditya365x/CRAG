# Vercel container image: traffic goes to port 80. Instances are stateless and scale to zero,
# so uploads live in /tmp only for the instance's lifetime; the demo index is copied there at start.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FASTEMBED_CACHE=/app/models \
    DATA_DIR=/tmp/crag_data \
    PORT=80

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

# Download MiniLM (ONNX, ~90 MB) at build time so the app never downloads it at runtime.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/all-MiniLM-L6-v2', cache_dir='/app/models')"

COPY documents ./documents
COPY app ./app

# Prebuild the demo book's index so the app works with zero uploads.
RUN DATA_DIR=/app/data python -m app.seed_demo

EXPOSE 80
CMD ["sh", "-c", "mkdir -p /tmp/crag_data && cp -rn /app/data/. /tmp/crag_data/ && uvicorn app.api:app --host 0.0.0.0 --port ${PORT}"]
